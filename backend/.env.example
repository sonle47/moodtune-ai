# Get a free key at https://aistudio.google.com/apikey
# Then copy this file to ".env" and paste your key below.
GEMINI_API_KEY=

# Needed for the "play the song" feature. Get a free key at
# https://console.cloud.google.com/apis/credentials — click "Create
# Credentials" -> "API key", then make sure the "YouTube Data API v3"
# is enabled for that project (search for it in the API Library and
# click Enable).
YOUTUBE_API_KEY=

# Which frontend URL(s) are allowed to call this API from a browser.
# Comma-separated, no spaces. Defaults to localhost if unset — only
# needed once you deploy the frontend somewhere real (e.g. Vercel):
# ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
